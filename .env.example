# 复制本文件为 .env 后填入自己的 Key
cp .env.example .env

# 模型接口：MiniMax 开放平台（OpenAI 兼容）
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=在这里填你的_api_key
LLM_MODEL=MiniMax-M2.7
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=180
# 1=流式（默认），0=非流式
LLM_STREAM=1

# 思考强度: low(默认) / medium / high / xhigh / max / default(模型自定)
LLM_EFFORT=low

# 工具的工作根目录（默认是项目根目录）
# AGENT_WORKDIR=/Users/yzy/Desktop/study_code/ai-test/agent-loop

# 单轮内最多调用工具次数
# AGENT_MAX_STEPS=8
